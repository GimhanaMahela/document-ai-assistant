# ─────────────────────────────────────────────────────────
# Document AI Assistant — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
#
# LLM Priority: Groq → OpenAI → Local Flan-T5 (fallback)
# Set only the key for the provider you want to use.

# ── Groq (Recommended — free tier, fastest) ───────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=

# Groq model to use. Options:
#   llama-3.3-70b-versatile   ← best quality (default)
#   llama-3.1-8b-instant      ← fastest responses
#   deepseek-r1-distill-llama-70b ← best for complex reasoning
#   mixtral-8x7b-32768        ← largest context window (32K)
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (Optional fallback) ────────────────────────────
# Only used if GROQ_API_KEY is not set.
OPENAI_API_KEY=

# ── Chunking Settings ─────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Storage Paths ─────────────────────────────────────────
PERSIST_DIRECTORY=./data/chroma_db
DATABASE_PATH=./chat_history.db

# ── File Upload Settings ──────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── ChromaDB Settings ─────────────────────────────────────
# Disables telemetry to prevent posthog API errors on startup.
ANONYMIZED_TELEMETRY=False

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
