# ─────────────────────────────────────────────
# Document AI Assistant — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# ── LLM Configuration ─────────────────────────
# Leave blank to use the free local Flan-T5 model.
# Set your OpenAI key to use GPT-3.5-turbo instead.
OPENAI_API_KEY=

# ── Chunking Settings ─────────────────────────
# Number of characters per document chunk.
CHUNK_SIZE=1000

# Overlap between consecutive chunks (prevents context loss at boundaries).
CHUNK_OVERLAP=200

# ── Storage Paths ─────────────────────────────
# Directory where ChromaDB persists vector embeddings.
PERSIST_DIRECTORY=./data/chroma_db

# Path to the SQLite database for chat history and document metadata.
DATABASE_PATH=./chat_history.db

# ── File Upload Settings ──────────────────────
# Maximum allowed file size for uploads (in megabytes).
MAX_FILE_SIZE_MB=50

# ── Logging ───────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
